rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    /**
     * Customer profile photos, one object per account under a folder named
     * after the uid.
     *
     * Any signed-in caller can read one — the download URL is only ever handed
     * back to its owner — but only the owner can write, and only a reasonably
     * sized image.
     */
    match /customer_photos/{customerId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == customerId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == customerId;
    }

    // Nothing else is reachable from a client.
    match /{allOtherPaths=**} {
      allow read, write: if false;
    }
  }
}
