rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * True when the signed-in user has a corresponding /admins document.
     * This is the single source of truth for "is this caller an admin".
     */
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    /**
     * True when the caller is the signed-in customer whose document this is.
     */
    function isSelf(customerId) {
      return request.auth != null && request.auth.uid == customerId;
    }

    // Product catalog: visible to everyone.
    // TEMPORARY: the admin dashboard edits products through a hard-coded login
    // with no Firebase Auth token, so writes can't satisfy isAdmin() yet. Opened
    // like orders below until Firebase Auth is enabled — then restore
    // `allow write: if isAdmin();`.
    match /products/{productId} {
      allow read: if true;
      allow write: if true;  // TODO: restore isAdmin() after enabling Auth
    }

    // Orders: any client (including anonymous customers) can place an order.
    // TEMPORARY: reads/updates are open because the admin dashboard currently
    // uses a hard-coded login with no Firebase Auth token. Re-gate these behind
    // isAdmin() once Firebase Auth is enabled. Orders are never deleted.
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;    // TODO: restore isAdmin() after enabling Auth
      allow update: if true;  // TODO: restore isAdmin() after enabling Auth
      allow delete: if false;
    }

    // Customer profiles: a customer sees and edits only their own, and nobody
    // else's — the profile carries a name, phone, address and photo. Cloud
    // Functions read the fcmToken through the Admin SDK, which bypasses rules.
    // Profiles are never deleted from the client.
    match /customers/{customerId} {
      allow create: if isSelf(customerId);
      allow read: if isSelf(customerId);
      allow update: if isSelf(customerId);
      allow delete: if false;
    }

    // Admin accounts: only other admins may read or manage them.
    match /admins/{userId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Analytics: admin-only in both directions; written by Cloud Functions
    // using the Admin SDK, which bypasses these rules entirely.
    match /analytics/{analyticsId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
