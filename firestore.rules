rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * True when the signed-in user has a corresponding /admins document.
     * This is the single source of truth for "is this caller an admin".
     */
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Product catalog: visible to everyone, editable only by admins.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: any client (including anonymous customers) can place an order.
    // TEMPORARY: reads/updates are open because the admin dashboard currently
    // uses a hard-coded login with no Firebase Auth token. Re-gate these behind
    // isAdmin() once Firebase Auth is enabled. Orders are never deleted.
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;    // TODO: restore isAdmin() after enabling Auth
      allow update: if true;  // TODO: restore isAdmin() after enabling Auth
      allow delete: if false;
    }

    // Admin accounts: only other admins may read or manage them.
    match /admins/{userId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Analytics: admin-only in both directions; written by Cloud Functions
    // using the Admin SDK, which bypasses these rules entirely.
    match /analytics/{analyticsId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
